    <div class="wrap">

      <%# Hero %>
      <section class="hero" id="top">
        <div class="term">
          <div class="term-bar">
            <span class="tc r"></span>
            <span class="tc y"></span>
            <span class="tc g"></span>
            <span class="term-title">tin-trung-duong &mdash; zsh &mdash; 80&times;24</span>
          </div>
          <div class="term-body">
            <div class="cmd"><span class="p">&#10148;</span> <span class="c">~</span> whoami</div>
            <div class="out">
              <span id="typed"
                    data-controller="typing"
                    data-typing-words-value='<%= t("hero.typed_words") %>'></span><span class="caret"></span>
            </div>
            <div class="cmd"><span class="p">&#10148;</span> <span class="c">~</span> cat about.txt</div>
            <div class="tagline">
              <%= t("hero.tagline") %>
            </div>
            <div class="cta-row">
              <a href="#work"    class="btn solid">&#8594; <%= t("hero.cta_products") %></a>
              <a href="/cv.pdf"  class="btn">&#8595; <%= t("hero.cta_cv") %></a>
              <a href="#contact" class="btn"><%= t("hero.cta_hello") %></a>
              <a href="https://github.com/tinduong" target="_blank" rel="noopener" class="btn"><%= t("hero.cta_github") %></a>
            </div>
          </div>
        </div>
      </section>

