              <ul class="job-bullets">
                <li><%= t("experience.job4_b1") %></li>
                <li><%= t("experience.job4_b2") %></li>
                <li><%= t("experience.job4_b3") %></li>
              </ul>
              <div class="badge-row">
                <span class="tag">.NET Core</span>
                <span class="tag">C#</span>
                <span class="tag">React.js</span>
                <span class="tag">Azure Kubernetes</span>
                <span class="tag">RabbitMQ</span>
              </div>
            </div>
          </div>

          <div class="job">
            <div class="when"><%= t("experience.job5_when") %></div>
            <div>
              <h3><%= t("experience.job5_title") %></h3>
              <div class="org">@ <%= t("experience.job5_org") %></div>
              <ul class="job-bullets">
