      <%# Products %>
      <section id="work">
        <div class="seclabel"><%= t("products.label") %><span class="bar"></span></div>
        <h2 class="big"><%= t("products.heading") %></h2>
        <p class="lede" style="margin-bottom:1.625rem">
          <%= t("products.intro") %>
        </p>

        <div class="projects">

          <%# Featured card - CostTracker %>
          <article class="card-featured">
            <div class="feat-shot">
              <img src="https://costtracker.com/api/media/file/dashboard-new-updated.png"
                   alt="CostTracker dashboard screenshot"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
            </div>
            <div class="feat-body">
              <div class="feat-label">&#9733; <%= t("products.role_cto") %></div>
              <h3>CostTracker</h3>
              <p><%= t("products.costtracker_desc") %></p>
              <div class="tags">
                <span class="tag">Ruby on Rails</span>
                <span class="tag">Hotwire</span>
                <span class="tag">PostgreSQL</span>
                <span class="tag">Sidekiq</span>
                <span class="tag">AWS</span>
                <span class="tag">Docker</span>
              </div>
              <div style="margin-top:0.5rem">
                <a href="https://costtracker.com" target="_blank" rel="noopener" class="card-link"><%= t("products.live_product") %> &#8594;</a>
              </div>
            </div>
          </article>

          <%# Luca Regnskap %>
          <article class="card">
            <div class="card-head">
              <span class="tc r"></span><span class="tc y"></span><span class="tc g"></span>
              lucaregnskap.no
            </div>
            <div class="card-shot">
              <img src="https://www.lucaregnskap.no/assets/images/bilde_av_kvittering.webp"
                   alt="Luca Regnskap mobile receipt scanning"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;object-position:center top;" />
            </div>
            <div class="card-body">
              <div class="feat-label" style="font-size:0.7rem;margin-bottom:0.4rem">&#9733; <%= t("products.role_key") %></div>
              <h3>Luca Regnskap</h3>
              <p><%= t("products.luca_desc") %></p>
              <div class="tags">
                <span class="tag">Full-Stack</span>
                <span class="tag">Accounting</span>
                <span class="tag">EHF / Vipps</span>
              </div>
              <a href="https://www.lucaregnskap.no" target="_blank" rel="noopener" class="card-link"><%= t("products.live_product") %> &#8594;</a>
            </div>
          </article>

          <%# Riverty %>
          <article class="card">
            <div class="card-head">
              <span class="tc r"></span><span class="tc y"></span><span class="tc g"></span>
              riverty.com
            </div>
            <div class="card-shot">
              <img src="https://www.riverty.com/globalassets/media-images/products-b2b/o2c/stage/riverty-invoicing-as-a-service-stage.png"
                   alt="Riverty Invoicing as a Service"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;" />
            </div>
            <div class="card-body">
              <div class="feat-label" style="font-size:0.7rem;margin-bottom:0.4rem">&#9733; <%= t("products.role_key") %></div>
              <h3>Riverty Invoicing as a Service</h3>
              <p><%= t("products.riverty_desc") %></p>
              <div class="tags">
                <span class="tag">Fintech</span>
                <span class="tag">Invoice Lifecycle</span>
                <span class="tag">B2B SaaS</span>
              </div>
              <a href="https://www.riverty.com/no-no/bedrift/produkter/invoicing-as-a-service/" target="_blank" rel="noopener" class="card-link"><%= t("products.live_product") %> &#8594;</a>
            </div>
          </article>

          <%# Brevio Confirm %>
          <article class="card">
            <div class="card-head">
              <span class="tc r"></span><span class="tc y"></span><span class="tc g"></span>
              brevio.com/confirm
            </div>
            <div class="card-shot">
              <img src="https://images.prismic.io/breviocom2/8964df8a-8a04-4967-bbee-04d25fd2b5a8_brevio.mockup.confirm.no.png?auto=compress%2Cformat&fit=max&w=1200"
                   alt="Brevio Confirm product screenshot"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;object-position:top;" />
            </div>
            <div class="card-body">
              <div class="feat-label" style="font-size:0.7rem;margin-bottom:0.4rem">&#9733; <%= t("products.role_key") %></div>
              <h3>Brevio Confirm</h3>
              <p><%= t("products.brevio_confirm_desc") %></p>
              <div class="tags">
                <span class="tag">Audit Tech</span>
                <span class="tag">Nordic Banks</span>
                <span class="tag">REST API</span>
              </div>
              <a href="https://www.brevio.com/no/confirm" target="_blank" rel="noopener" class="card-link"><%= t("products.live_product") %> &#8594;</a>
            </div>
          </article>

          <%# Brevio Sign %>
          <article class="card">
            <div class="card-head">
              <span class="tc r"></span><span class="tc y"></span><span class="tc g"></span>
              brevio.com/sign
            </div>
            <div class="card-shot">
              <img src="https://images.prismic.io/breviocom2/a597c956-46bc-47d4-9c6a-4518198ae29a_brevio.mockup.sign.no.png?auto=compress%2Cformat&fit=max&w=1200"
                   alt="Brevio Sign product screenshot"
                   loading="lazy"
                   style="width:100%;height:100%;object-fit:cover;object-position:top;" />
            </div>
            <div class="card-body">
              <div class="feat-label" style="font-size:0.7rem;margin-bottom:0.4rem">&#9733; <%= t("products.role_key") %></div>
              <h3>Brevio Sign</h3>
              <p><%= t("products.brevio_sign_desc") %></p>
              <div class="tags">
                <span class="tag">eIDAS</span>
                <span class="tag">Digital Signatures</span>
                <span class="tag">Nordic eID</span>
              </div>
              <a href="https://www.brevio.com/no/sign" target="_blank" rel="noopener" class="card-link"><%= t("products.live_product") %> &#8594;</a>
            </div>
          </article>

        </div>
      </section>

      <%# Stack %>
      <section id="stack">
        <div class="seclabel"><%= t("stack.label") %><span class="bar"></span></div>
        <h2 class="big"><%= t("stack.heading") %></h2>
        <p class="lede" style="margin-bottom:1.5rem">
          <%= t("stack.intro") %>
        </p>

        <div class="stackgrid">
          <div class="col">
            <h4><%= t("stack.languages") %></h4>
            <ul>
              <li>Ruby <span class="skill-note"><%= t("stack.primary") %></span></li>
              <li>TypeScript</li>
              <li>Python</li>
              <li>Go</li>
              <li>Rust</li>
              <li>SQL</li>
            </ul>
          </div>
          <div class="col">
            <h4><%= t("stack.frontend") %></h4>
            <ul>
              <li>Hotwire / Turbo <span class="skill-note"><%= t("stack.primary") %></span></li>
              <li>Stimulus</li>
              <li>React</li>
              <li>Tailwind CSS</li>
              <li>esbuild</li>
              <li>SCSS / CSS</li>
            </ul>
          </div>
          <div class="col">
            <h4><%= t("stack.backend") %></h4>
            <ul>
              <li>Rails <span class="skill-note"><%= t("stack.primary") %></span></li>
              <li>PostgreSQL</li>
              <li>Redis</li>
              <li>Sidekiq</li>
              <li>GraphQL</li>
              <li>REST APIs</li>
            </ul>
          </div>
          <div class="col">
            <h4><%= t("stack.infra") %></h4>
            <ul>
              <li>Kamal / Docker</li>
              <li>AWS (EC2, S3, RDS)</li>
              <li>Terraform</li>
              <li>GitHub Actions</li>
              <li>Datadog / Sentry</li>
              <li>Vim / tmux</li>
            </ul>
          </div>
        </div>

        <div class="quotes">
          <div class="quote-card">
            <blockquote><%= t("stack.quote1_text") %></blockquote>
            <div class="quote-attr">&mdash; <span><%= t("stack.quote1_attr") %></span></div>
          </div>
          <div class="quote-card">
            <blockquote><%= t("stack.quote2_text") %></blockquote>
            <div class="quote-attr">&mdash; <span><%= t("stack.quote2_attr") %></span></div>
          </div>
        </div>
      </section>

      <%# Contact %>
      <section id="contact">
        <div class="seclabel"><%= t("contact.label") %><span class="bar"></span></div>

        <div class="contact-box">
          <h2><%= t("contact.heading") %></h2>
          <p class="lede" style="margin:0">
            <%= t("contact.intro") %>
          </p>

          <div class="avail-strip">
            <span class="dot"></span>
            <span class="avail-label"><%= t("contact.available") %></span>
            <span class="avail-sep">|</span>
            <span><%= t("contact.availability_detail") %></span>
          </div>

          <div class="links">
            <a href="mailto:tin@costtracker.no" class="btn solid">&#8594;&nbsp;tin@costtracker.no</a>
            <a href="https://github.com/tinduong" target="_blank" rel="noopener" class="btn"><%= t("contact.github") %></a>
            <a href="https://www.linkedin.com/in/tin-trung-duong-8ab6a9140/" target="_blank" rel="noopener" class="btn"><%= t("contact.linkedin") %></a>
            <a href="/cv.pdf" class="btn"><%= t("contact.download_cv") %></a>
          </div>
        </div>
      </section>

    </div><%# /wrap %>
  </main>
</div><%# /shell %>
