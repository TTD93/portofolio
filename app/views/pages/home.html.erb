<%# Language switcher helper %>
<div class="lang-switch">
  <% if I18n.locale == :en %>
    <%= link_to "NO", root_path(locale: :no), class: "lang-btn" %>
  <% else %>
    <%= link_to "EN", root_path(locale: nil), class: "lang-btn" %>
  <% end %>
</div>

<%# Mobile topbar %>
<div class="topbar" data-controller="mobile-menu">
  <span class="tu">~/tin-trung-duong</span>
  <button class="burger"
          aria-label="Open menu"
          data-action="click->mobile-menu#open">&#8801;</button>
</div>

<%# Mobile drawer %>
<div class="msheet"
     id="msheet"
     data-mobile-menu-target="sheet">
  <button class="burger close"
          aria-label="Close menu"
          data-action="click->mobile-menu#close">&#x2715;</button>
  <nav class="snav">
    <a href="#about"   data-action="click->mobile-menu#close"><span class="num">01</span> <%= t("nav.about") %></a>
    <a href="#cv"      data-action="click->mobile-menu#close"><span class="num">02</span> <%= t("nav.experience") %></a>
    <a href="#work"    data-action="click->mobile-menu#close"><span class="num">03</span> <%= t("nav.products") %></a>
    <a href="#stack"   data-action="click->mobile-menu#close"><span class="num">04</span> <%= t("nav.stack") %></a>
    <a href="#contact" data-action="click->mobile-menu#close"><span class="num">05</span> <%= t("nav.contact") %></a>
  </nav>
</div>

<div class="shell">
  <%# Sidebar %>
  <aside class="sidebar">
    <%# ID card %>
    <div class="idcard">
      <div class="avatar">photo</div>
      <div>
        <div class="uname"><b>Tin Trung Duong</b></div>
        <div class="role"><%= t("sidebar.role") %></div>
      </div>
      <div class="statusline">
        <span class="dot"></span> <%= t("sidebar.available") %>
      </div>
    </div>

    <%# Currently widget %>
    <div class="sidebar-widget">
      <div class="widget-label"><%= t("sidebar.currently_label") %></div>
      <div class="widget-item"><%= t("sidebar.currently_1") %></div>
      <div class="widget-item"><%= t("sidebar.currently_2") %></div>
      <div class="widget-item"><%= t("sidebar.currently_3") %></div>
    </div>

    <%# Nav %>
    <nav class="snav"
         id="deskNav"
         data-controller="nav"
         data-nav-sections-value='["about","cv","work","stack","contact"]'>
      <a href="#about"   class="active" data-nav-target="link"><span class="num">01</span> <%= t("nav.about") %></a>
      <a href="#cv"      data-nav-target="link"><span class="num">02</span> <%= t("nav.experience") %></a>
      <a href="#work"    data-nav-target="link"><span class="num">03</span> <%= t("nav.products") %></a>
      <a href="#stack"   data-nav-target="link"><span class="num">04</span> <%= t("nav.stack") %></a>
      <a href="#contact" data-nav-target="link"><span class="num">05</span> <%= t("nav.contact") %></a>
    </nav>

    <%# Footer %>
    <div class="sfoot">
      <div><a href="https://github.com/tinduong" target="_blank" rel="noopener">github.com/tinduong</a></div>
      <div><a href="https://www.linkedin.com/in/tin-trung-duong-8ab6a9140/" target="_blank" rel="noopener">linkedin.com/in/tinduong</a></div>
      <div><a href="mailto:tin@costtracker.no">tin@costtracker.no</a></div>
      <div>&copy; <%= t("sidebar.footer_copyright") %></div>
    </div>
  </aside>

  <%# Main %>
  <main class="main">
    <div class="wrap">

      <%# Hero %>
      <section class="hero" id="top">
        <div class="term">
          <div class="term-bar">
            <span class="tc r"></span>
            <span class="tc y"></span>
            <span class="tc g"></span>
            <span class="term-title">tin-trung-duong &mdash; zsh &mdash; 80&times;24</span>
          </div>
          <div class="term-body">
            <div class="cmd"><span class="p">&#10148;</span> <span class="c">~</span> whoami</div>
            <div class="out">
              <span id="typed"
                    data-controller="typing"
                    data-typing-words-value='<%= t("hero.typed_words") %>'></span><span class="caret"></span>
            </div>
            <div class="cmd"><span class="p">&#10148;</span> <span class="c">~</span> cat about.txt</div>
            <div class="tagline">
              <%= t("hero.tagline") %>
            </div>
            <div class="cta-row">
              <a href="#work"    class="btn solid">&#8594; <%= t("hero.cta_products") %></a>
              <a href="/cv.pdf"  class="btn">&#8595; <%= t("hero.cta_cv") %></a>
              <a href="#contact" class="btn"><%= t("hero.cta_hello") %></a>
              <a href="https://github.com/tinduong" target="_blank" rel="noopener" class="btn"><%= t("hero.cta_github") %></a>
            </div>
          </div>
        </div>
      </section>

      <%# About %>
      <section id="about">
        <div class="seclabel"><%= t("about.label") %><span class="bar"></span></div>
        <h2 class="big"><%= t("about.heading") %></h2>

        <p class="lede"><%= t("about.p1").html_safe %></p>
        <p class="lede"><%= t("about.p2").html_safe %></p>

        <div class="stats">
          <div class="stat">
            <div class="n"><%= t("about.stat_years_n") %></div>
            <div class="l"><%= t("about.stat_years_l") %></div>
          </div>
          <div class="stat">
            <div class="n"><%= t("about.stat_products_n") %></div>
            <div class="l"><%= t("about.stat_products_l") %></div>
          </div>
          <div class="stat">
            <div class="n"><%= t("about.stat_oss_n") %></div>
            <div class="l"><%= t("about.stat_oss_l") %></div>
          </div>
        </div>

        <div class="highlights">
          <div class="highlight-card">
            <div class="hi-icon"><%= t("about.highlight_perf_icon").html_safe %></div>
            <div class="hi-title"><%= t("about.highlight_perf_title") %></div>
            <div class="hi-body"><%= t("about.highlight_perf_body") %></div>
          </div>
          <div class="highlight-card">
            <div class="hi-icon"><%= t("about.highlight_ship_icon").html_safe %></div>
            <div class="hi-title"><%= t("about.highlight_ship_title") %></div>
            <div class="hi-body"><%= t("about.highlight_ship_body") %></div>
          </div>
          <div class="highlight-card">
            <div class="hi-icon"><%= t("about.highlight_data_icon").html_safe %></div>
            <div class="hi-title"><%= t("about.highlight_data_title") %></div>
            <div class="hi-body"><%= t("about.highlight_data_body") %></div>
          </div>
          <div class="highlight-card">
            <div class="hi-icon"><%= t("about.highlight_remote_icon").html_safe %></div>
            <div class="hi-title"><%= t("about.highlight_remote_title") %></div>
            <div class="hi-body"><%= t("about.highlight_remote_body") %></div>
          </div>
        </div>
      </section>

      <%# Experience %>
      <section id="cv">
