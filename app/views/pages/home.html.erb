                <span class="tag">TypeScript</span>
                <span class="tag">Terraform</span>
              </div>
            </div>
          </div>

          <div class="job">
            <div class="when"><%= t("experience.job3_when") %></div>
            <div>
              <h3><%= t("experience.job3_title") %></h3>
              <div class="org">@ <%= t("experience.job3_org") %></div>
              <ul class="job-bullets">
                <li><%= t("experience.job3_b1") %></li>
                <li><%= t("experience.job3_b2") %></li>
                <li><%= t("experience.job3_b3") %></li>
              </ul>
              <div class="badge-row">
                <span class="tag">Ruby on Rails</span>
                <span class="tag">React.js</span>
                <span class="tag">Redis</span>
                <span class="tag">AWS</span>
                <span class="tag">PostgreSQL</span>
